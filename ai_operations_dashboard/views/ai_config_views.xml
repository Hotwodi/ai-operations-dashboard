<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_ai_config_settings" model="ir.actions.act_window">
            <field name="name">AI Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'ai_operations_dashboard'}</field>
        </record>

        <record id="view_ai_config_settings" model="ir.ui.view">
            <field name="name">AI Operations Settings</field>
            <field name="model">res.config.settings</field>
            <field name="priority">100</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app string="AI Operations" name="ai_operations_dashboard">
                        <block title="AI Configuration" name="ai_config_container">
                            <setting id="ai_provider" string="AI Provider" help="Choose the AI provider for insights and automation.">
                                <field name="ai_provider" widget="selection"/>
                            </setting>
                            <setting id="ai_api_key" string="API Key" help="The API key for the selected provider.">
                                <field name="ai_api_key" password="True"/>
                            </setting>
                            <setting id="ai_model" string="Model" help="Model name (e.g., gpt-4o, claude-3-5-sonnet).">
                                <field name="ai_model"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
