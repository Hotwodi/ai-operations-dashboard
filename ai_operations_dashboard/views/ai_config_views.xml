<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_ai_config_settings" model="ir.actions.act_window">
            <field name="name">AI Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module' : 'ai_operations_dashboard'}</field>
        </record>

        <record id="view_ai_config_settings" model="ir.ui.view">
            <field name="name">AI Operations Settings</field>
            <field name="model">res.config.settings</field>
            <field name="priority">100</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[hasclass('settings')][1]" position="inside">
                    <h2>AI Operations</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">AI Provider</span>
                                <div class="text-muted">Choose the AI provider for insights and automation.</div>
                                <div class="content-group">
                                    <field name="ai_provider" class="o_light_label" widget="selection"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">API Key</span>
                                <div class="text-muted">The API key for the selected provider.</div>
                                <field name="ai_api_key" password="True" class="o_light_label"/>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">Model</span>
                                <div class="text-muted">Model name (e.g., gpt-4o, claude-3-5-sonnet).</div>
                                <field name="ai_model" class="o_light_label"/>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
